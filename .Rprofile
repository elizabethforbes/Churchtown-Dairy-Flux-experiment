# Project-local R library: pins goFlux to the fork release used for this paper
# (jgewirtzman/goFlux v0.5.0.9002, commit 006f625; doi:10.5281/zenodo.23256675).
# Install once with:
#   remotes::install_github("jgewirtzman/goFlux@v0.5.0.9002", lib = "r-lib", dependencies = FALSE)
if (dir.exists("r-lib")) .libPaths(c(normalizePath("r-lib"), .libPaths()))
